{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://openriskplatform.github.io/plugin-sdk/schemas/plugin-manifest-v0.0.2.schema.json",
    "title": "OpenRisk Plugin Manifest 0.0.2",
    "description": "OpenRisk plugin SDK manifest contract with backwards-compatible application extensions.",
    "type": "object",
    "required": [
        "id",
        "version",
        "name",
        "description",
        "authors",
        "license",
        "main",
        "entrypoints"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "Stable plugin identifier used in project database",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference for IDE support"
        },
        "entrypoints": {
            "type": "array",
            "description": "Named entrypoints exposed by the plugin. At least one named entrypoint is required.",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/PluginEntrypointDefinition"
            }
        },
        "version": {
            "type": "string",
            "description": "Plugin version"
        },
        "name": {
            "type": "string",
            "description": "Human-readable plugin name",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "description": "Brief description of plugin functionality",
            "minLength": 1
        },
        "authors": {
            "type": "array",
            "description": "List of plugin authors",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Author name"
                    },
                    "email": {
                        "type": "string",
                        "description": "Author email address"
                    },
                    "url": {
                        "type": "string",
                        "description": "Author website"
                    }
                },
                "additionalProperties": false
            }
        },
        "icon": {
            "type": "string",
            "description": "Plugin icon"
        },
        "license": {
            "type": "string",
            "description": "SPDX license identifier (e.g., MIT, Apache-2.0, GPL-3.0)",
            "minLength": 1
        },
        "main": {
            "type": "string",
            "description": "Main TypeScript/JavaScript file (relative to plugin directory)",
            "pattern": "^[^/].*\\.(ts|js)$"
        },
        "update_metrics_fn": {
            "type": "string",
            "description": "Optional function name to call for refreshing declared metrics in settings."
        },
        "settings": {
            "type": "array",
            "description": "Plugin configuration settings",
            "items": {
                "$ref": "#/definitions/SettingDefinition"
            }
        },
        "metrics": {
            "type": "array",
            "description": "Runtime metrics emitted by plugin code through openrisk.metrics.* receiver.",
            "items": {
                "$ref": "#/definitions/MetricDefinition"
            }
        },
        "repository": {
            "type": "string",
            "description": "Plugin source code repository URL"
        },
        "homepage": {
            "type": "string",
            "description": "Plugin homepage URL"
        },
        "keywords": {
            "type": "array",
            "description": "Plugin keywords for searchability",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": false,
    "definitions": {
        "PluginEntrypointDefinition": {
            "description": "A named entrypoint exposed by a plugin.",
            "type": "object",
            "required": [
                "id",
                "name",
                "function",
                "inputs"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable entrypoint identifier (kebab-case)",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "name": {
                    "type": "string",
                    "description": "Human-readable entrypoint name",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "description": "Entrypoint description"
                },
                "function": {
                    "type": "string",
                    "description": "Named export function in the entrypoint file",
                    "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
                },
                "inputs": {
                    "type": "array",
                    "description": "Entrypoint-specific input parameters.",
                    "items": {
                        "$ref": "#/definitions/InputDefinition"
                    }
                }
            },
            "additionalProperties": false
        },
        "ValidationRules": {
            "type": "object",
            "description": "Additional validation rules (legacy fallback for enum).",
            "properties": {
                "enum": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Allowed values for enum-like fields."
                }
            },
            "additionalProperties": false
        },
        "FieldType": {
            "description": "Input/setting type: shorthand string or detailed object.",
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "string",
                        "number",
                        "boolean",
                        "integer",
                        "date",
                        "url",
                        "jurisdiction-iso-3166-2",
                        "registry-jurisdiction-code"
                    ]
                },
                {
                    "type": "object",
                    "required": [
                        "name"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "enum": [
                                "string",
                                "number",
                                "boolean",
                                "integer",
                                "date",
                                "url",
                                "enum",
                                "jurisdiction-iso-3166-2",
                                "registry-jurisdiction-code"
                            ]
                        },
                        "values": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Enum values when name='enum'."
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "InputDefinition": {
            "type": "object",
            "required": [
                "name",
                "type",
                "title"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Input parameter name passed to the plugin entrypoint"
                },
                "type": {
                    "$ref": "#/definitions/FieldType"
                },
                "optional": {
                    "type": "boolean",
                    "description": "Whether this input is optional",
                    "default": false
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether this input is required"
                },
                "title": {
                    "type": "string",
                    "description": "Human-readable input name"
                },
                "description": {
                    "type": "string",
                    "description": "Detailed input description"
                },
                "default": {
                    "description": "Default value for optional inputs"
                },
                "validation": {
                    "$ref": "#/definitions/ValidationRules"
                }
            },
            "additionalProperties": false
        },
        "SettingDefinition": {
            "type": "object",
            "required": [
                "name",
                "type",
                "title"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Setting identifier"
                },
                "type": {
                    "$ref": "#/definitions/FieldType"
                },
                "title": {
                    "type": "string",
                    "description": "Human-readable setting name"
                },
                "description": {
                    "type": "string",
                    "description": "Detailed setting description"
                },
                "default": {
                    "description": "Default value for the setting (null allowed)"
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether this setting is required",
                    "default": false
                },
                "optional": {
                    "type": "boolean",
                    "description": "Whether this setting is optional"
                },
                "secret": {
                    "type": "boolean",
                    "description": "Frontend hint that this setting contains sensitive data and should use a secret input control",
                    "default": false
                },
                "validation": {
                    "$ref": "#/definitions/ValidationRules"
                }
            },
            "additionalProperties": false
        },
        "MetricDefinition": {
            "type": "object",
            "required": [
                "name",
                "type",
                "title"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Metric key used by openrisk.metrics.set/get/inc"
                },
                "type": {
                    "$ref": "#/definitions/FieldType"
                },
                "title": {
                    "type": "string",
                    "description": "Human-readable metric name"
                },
                "description": {
                    "type": "string",
                    "description": "Metric purpose shown in UI"
                },
                "optional": {
                    "type": "boolean"
                },
                "required": {
                    "type": "boolean"
                },
                "default": {
                    "description": "Default metric value"
                }
            },
            "additionalProperties": false
        }
    }
}
